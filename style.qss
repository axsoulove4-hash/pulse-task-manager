/* Pulse desktop theme. Tokens replaced from the chosen palette. */
QWidget { font-family: "Noto Sans"; font-size: 12px; color: @text; }
QMainWindow, QStackedWidget { background: @bg; }
QWidget#toolbar { background: @base; border-bottom: 1px solid @border; }
QLabel#appName { font-size: 15px; font-weight: 600; }
QLabel#heading { font-size: 20px; font-weight: 600; }
QLabel#muted { color: @muted; }
QPushButton, QComboBox, QLineEdit {
    background: @base; border: 1px solid @border; border-radius: 4px;
    padding: 6px 10px; min-height: 18px;
}
QPushButton:hover, QComboBox:hover { background: @hover; }
QPushButton:pressed { background: @selection; }
QPushButton:focus, QLineEdit:focus, QComboBox:focus { border-color: @accent; }
QPushButton:disabled { color: @muted; border-color: @border; }
QPushButton#nav { border: none; border-bottom: 2px solid transparent; border-radius: 0; padding: 13px 16px; background: transparent; }
QPushButton#nav:hover { background: @hover; }
QPushButton#nav:checked { color: @text; border-bottom-color: @accent; font-weight: 600; }
QPushButton#danger { color: @danger; }
QLineEdit { padding: 7px 10px; }

/* --- QTreeWidget (process list) --- */
QTreeWidget {
    background: @base;
    alternate-background-color: @alternate;
    border: 1px solid @border;
    border-radius: 3px;
    selection-background-color: @selection;
    selection-color: @text;
    outline: none;
}
QTreeWidget::item {
    padding: 3px 8px;
    border: none;
}
QTreeWidget::item:selected {
    background: @selection;
    color: @text;
}
QTreeWidget::item:hover:!selected {
    background: @hover;
}
/* Category (top-level) items — bolder style handled via font in code */
QTreeWidget::item:!enabled {
    color: @muted;
    background: @alternate;
    font-weight: 600;
}
/* Branch arrows — flèches natives Qt */
QTreeWidget::branch {
    background: transparent;
}
QTreeWidget::branch:has-children:!has-siblings:closed,
QTreeWidget::branch:closed:has-children:has-siblings {
    image: url(none);
}
QTreeWidget::branch:open:has-children:!has-siblings,
QTreeWidget::branch:open:has-children:has-siblings {
    image: url(none);
}

/* Legacy QTableWidget kept for compatibility */
QTableWidget { background: @base; alternate-background-color: @alternate; border: 1px solid @border; border-radius: 3px; selection-background-color: @selection; selection-color: @text; }
QTableWidget::item { padding: 0px 8px; border: none; }

QHeaderView::section { background: @bg; color: @muted; border: none; border-bottom: 1px solid @border; padding: 8px; font-weight: 500; }
QStatusBar { background: @base; border-top: 1px solid @border; }
QStatusBar::item { border: none; }
QStatusBar QPushButton { padding: 3px 10px; margin: 3px 8px; }
QCheckBox { spacing: 7px; }
QToolTip { background: @base; color: @text; border: 1px solid @border; padding: 5px; }
QComboBox QAbstractItemView { background: @base; color: @text; selection-background-color: @selection; }
QMenu { background: @base; color: @text; border: 1px solid @border; padding: 4px; }
QMenu::item { padding: 7px 28px 7px 12px; border-radius: 3px; }
QMenu::item:selected { background: @selection; }
QMenu::item:disabled { color: @muted; }
QMenu::separator { height: 1px; background: @border; margin: 4px 8px; }
